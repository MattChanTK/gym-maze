# Per-repo settings for the kit's tools. Copy to kit.env (tracked; no secrets here, those go in .env.local / CLAUDE.local.md).
KIT_PROJECT="gym-maze"
KIT_MAIN_BRANCH="master"
# Your everyday checkout. Tests, QA and uploads refuse to run there (use tools/worktree.sh). Empty = no guard.
KIT_PROTECTED_CHECKOUT="$HOME/Projects/gym-maze"
# Worktrees live here (default ~/Projects/.worktrees/<repo>).
# KIT_WORKTREE_ROOT="$HOME/Projects/.worktrees/gym-maze"
# .env.local names that are public on purpose, skipped by the secret scan.
KIT_PUBLIC_SETTINGS="SERVER_URL TEST_SERVER_URL CONTACT_EMAIL"
# Commit trailer added by tools/commit.sh.
KIT_ATTRIBUTION="Co-Authored-By: Claude <noreply@anthropic.com>"
# Repo test suites run by tools/check.sh, one command per line.
KIT_CHECKS="
python3 -m unittest discover -s tests
"

# --- iOS add-on (kit/ios/), only if this repo is an iOS app ---
# KIT_XCODE_PROJECT="MyApp.xcodeproj"
# KIT_SCHEME="MyApp"
# KIT_TEST_CMD="tools/test.sh"            # what mac_pass.sh runs before the unsigned Debug build
# KIT_RUNNER_LABEL="mac"                  # self-hosted Mac runner's custom label
# KIT_APP_FILE_RE='^(MyApp/|MyApp\.xcodeproj/|tests/|.*\.xcconfig$)'   # paths that need the Swift check
# KIT_UI_FILE_RE='^MyApp/.*View\.swift$'  # paths that can change screenshots
# CLAUDE.local.md holds DEVICE, TEAM, BUNDLE. .env.local holds ASC_KEY_ID, ASC_ISSUER_ID, APPLE_BUNDLE_ID.
